  "metadata": {
    "title": "Mercenary spyware, hack-for-hire, and the forensics that expose them",
    "layer": "evidenced",
    "theme": "intel"
  },
  "notes": "Ported/expanded from bubble-map #239 spyware + Citizen Lab deep-dive. Citizen Lab is the counter-force: independent forensics that convert covert operations into sanctions and litigation.",
  "entities": [
    {
      "name": "Gamma_Group",
      "type": "vendor",
      "notes": "Gamma International (UK/Germany); FinFisher GmbH, Munich. Built the FinFisher/FinSpy 'lawful intercept' suite - full-device implants. FinFisher GmbH filed for insolvency 2022 after German export-law prosecution.",
      "capability_tier": "industrial",
      "source": ["https://citizenlab.ca/2013/03/you-only-click-twice-finfishers-global-proliferation-2/"]
    },
    {
      "name": "FinSpy",
      "type": "malware",
      "notes": "Gamma's modular implant (calls, messages, mic/camera, files). Amnesty (Sep 2020) found new variants targeting Egyptian civil society and first publicly revealed FinSpy for macOS and Linux alongside Windows/Android.",
      "capability_tier": "industrial",
      "source": ["https://www.amnesty.org/en/latest/research/2020/09/german-made-finspy-spyware-found-in-egypt/"]
    },
    {
      "name": "Hacking_Team",
      "type": "vendor",
      "notes": "Milan; 'Remote Control System' / Galileo, sold to abusive governments. Itself hacked in 2015 (400GB dump) confirming client lists incl. Sudan/Ethiopia. Wound down / reformed as Memento Labs.",
      "capability_tier": "industrial",
      "source": ["https://citizenlab.ca/2015/07/hacking-team-leak-highlights-citizen-lab-research/"]
    },
    {
      "name": "Candiru",
      "type": "vendor",
      "notes": "Tel Aviv (aka Sourgum). 'DevilsTongue' Windows spyware used against civil society across multiple countries. Added to US Commerce Entity List (2021) alongside NSO.",
      "capability_tier": "industrial",
      "source": ["https://citizenlab.ca/2021/07/hooking-candiru-another-mercenary-spyware-vendor-comes-into-focus/"]
    },
    {
      "name": "Hack_For_Hire",
      "type": "capability",
      "notes": "The mercenary phishing/hack-for-hire market. 'Dark Basin' (Citizen Lab, 2020) tied an operation targeting thousands (climate advocates, journalists) to India-based BellTroX - distinct from implant vendors but same clientele.",
      "capability_tier": "commercial",
      "source": ["https://citizenlab.ca/2020/06/dark-basin-uncovering-a-massive-hack-for-hire-operation/"]
    },
    {
      "name": "Apple",
      "type": "vendor",
      "notes": "Sued NSO (2021) after FORCEDENTRY and shipped Lockdown Mode; later moved to dismiss (2024) to protect threat-intel methods. Platform defender with dual incentives.",
      "source": ["https://www.apple.com/newsroom/2021/11/apple-sues-nso-group-to-curb-the-abuse-of-state-sponsored-spyware/"]
    },
    {
      "name": "Meta",
      "type": "vendor",
      "notes": "Meta/WhatsApp's 2019 suit over a zero-click (1,400 targets) produced a 2025 US jury verdict against NSO (~$167M punitive, later adjusted) - the first major courtroom loss for a spyware vendor.",
      "source": ["https://about.fb.com/news/2019/10/protecting-our-users-from-a-cyber-attack/"]
    }
  ],
