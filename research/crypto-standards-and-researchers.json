  "entities": [
    {"name": "RSA", "type": "method", "notes": "Public-key encryption/signatures; broken by Shor's algorithm on a CRQC.", "source": ["https://en.wikipedia.org/wiki/RSA_(cryptosystem)"]},
    {"name": "ECC", "type": "method", "notes": "Elliptic-curve public key (ECDSA/ECDH/Ed25519). Also Shor-vulnerable.", "source": ["https://nvlpubs.nist.gov/nistpubs/FIPS/NIST.FIPS.186-5.pdf"]},
    {"name": "AES_256", "type": "method", "notes": "Symmetric block cipher. Grover gives quadratic speedup only; 256-bit remains the post-quantum symmetric baseline.", "source": ["https://csrc.nist.gov/publications/detail/fips/197/final"]},
    {"name": "SHA_2", "type": "method", "notes": "Hash family. Grover-affected but not Shor-broken.", "source": ["https://csrc.nist.gov/publications/detail/fips/180/4/final"]},
