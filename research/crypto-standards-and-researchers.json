    {"name": "ML_DSA", "type": "method", "notes": "NIST FIPS 204 (CRYSTALS-Dilithium) lattice signatures.", "source": ["https://csrc.nist.gov/pubs/fips/204/final"]},
    {"name": "SLH_DSA", "type": "method", "notes": "NIST FIPS 205 (SPHINCS+) hash-based signatures. Conservative PQC backup.", "source": ["https://csrc.nist.gov/pubs/fips/205/final"]},
    {"name": "Dual_EC_DRBG", "type": "method", "notes": "NIST SP 800-90 Dual_EC_DRBG. Public controversy over NSA-influenced constants; withdrawn. Historical dual-use of a standard.", "source": ["https://csrc.nist.gov/News/2013/Supplemental-IETF-Statement-on-the-NSA"]},
    {"name": "NIST", "type": "affiliate", "notes": "US standards body for FIPS crypto. Runs the PQC competition and Dual_EC history.", "source": ["https://csrc.nist.gov/projects/post-quantum-cryptography"]},
